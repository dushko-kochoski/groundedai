# Safe local-development template. Copy this file to .env and keep .env untracked.
# The database password below is only the disposable Docker Compose development credential.
# API-key fields are intentionally empty placeholders; never commit real credentials.

APP_ENV=development
# Optional locally; required in production. Use at least 32 random ASCII characters.
# This is a GroundedAI workspace key, NOT your OpenAI provider key.
API_ACCESS_KEY=
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://groundedai:groundedai@localhost:5432/groundedai
DATABASE_ECHO=false
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=10485760
CHUNK_TARGET_CHARS=1000
CHUNK_OVERLAP_CHARS=150
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=text-embedding-3-small
# Required only when EMBEDDING_PROVIDER=openai.
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1536
EMBEDDING_TIMEOUT_SECONDS=20
EMBEDDING_MAX_RETRIES=2
EMBEDDING_BATCH_SIZE=64
GENERATION_PROVIDER=deterministic
GENERATION_MODEL=gpt-5-mini
# Required only when GENERATION_PROVIDER=openai.
OPENAI_API_KEY=
GENERATION_TIMEOUT_SECONDS=30
GENERATION_MAX_RETRIES=2
GENERATION_MAX_OUTPUT_TOKENS=800

# Optional: enables live PostgreSQL integration tests when explicitly set.
TEST_DATABASE_URL=

RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_TOP_K=20
RETRIEVAL_MIN_SCORE=0.15
RETRIEVAL_MAX_QUERY_CHARS=2000
RETRIEVAL_MAX_RETURNED_CHARS=6000
EVIDENCE_DETERMINISTIC_MIN_SCORE=0.26
# Unset until calibrated with real OpenAI embeddings; uncalibrated profiles fail safe.
EVIDENCE_OPENAI_MIN_SCORE=
EVALUATION_ROOT=evals

APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://groundedai:groundedai@localhost:5432/groundedai
DATABASE_ECHO=false
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=10485760
CHUNK_TARGET_CHARS=1000
CHUNK_OVERLAP_CHARS=150
EMBEDDING_DIMENSION=256

# Optional: enables live PostgreSQL integration tests when explicitly set.
TEST_DATABASE_URL=

# Reserved for later phases. No provider is called in Phase 1.
LLM_PROVIDER=mock
LLM_API_KEY=
EMBEDDING_PROVIDER=deterministic
EMBEDDING_API_KEY=
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.70
